{
  "name": "trinet-ai-smart-assist",
  "displayName": "TrishAI",
  "description": "An AI chat Agent which works on optimizing the queries for a trinet employee so that Trinet Employees can achieve increased productivity at reduced token cost",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trishAI-sidebar",
          "title": "TrishAI Context Tracker",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "trishAI-sidebar": [
        {
          "id": "trishAICoverageView",
          "name": "Codebase AI Coverage",
          "icon": "$(book)"
        }
      ]
    },
    "commands": [
      {
        "command": "trinet-ai-smart-assist.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "trishAI.generateSkeleton",
        "title": "Generate AST Skeleton",
        "icon": "$(zap)"
      },
      {
        "command": "trishAI.updateSkeleton",
        "title": "Regenerate AST Skeleton",
        "icon": "$(refresh)"
      },
      {
        "command": "trishAICoverageView.refresh",
        "title": "Refresh Coverage",
        "icon": "$(refresh)"
      },
      {
        "command": "trishAI.askLibrarian",
        "title": "Ask Librarian",
        "icon": "$(wand)"
      }
    ],
    "configuration": {
      "title": "TrishAI",
      "properties": {
        "trishAI.aiProvider": {
          "type": "string",
          "enum": ["copilot", "anthropic"],
          "enumDescriptions": [
            "Use the GitHub Copilot language model already active in this VS Code installation (no separate API key needed).",
            "Call Anthropic directly — requires an API key set in trishAI.anthropicApiKey."
          ],
          "default": "copilot",
          "description": "AI provider used to generate context summaries for source files."
        },
        "trishAI.copilotModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Copilot model family to prefer when `#trishAI.aiProvider#` is `copilot`. Examples: `gpt-4o`, `gpt-4o-mini`, `claude-3.5-sonnet`, `o3-mini`. Leave empty to use the best model VS Code selects automatically."
        },
        "trishAI.anthropicApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Anthropic API key used when `#trishAI.aiProvider#` is `anthropic`. Get one at https://console.anthropic.com/."
        },
        "trishAI.anthropicModel": {
          "type": "string",
          "default": "claude-haiku-4-5-20251001",
          "markdownDescription": "Anthropic model ID used when `#trishAI.aiProvider#` is `anthropic`. Examples: `claude-haiku-4-5-20251001`, `claude-sonnet-4-6`, `claude-opus-4-8`."
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "trishAI.generateSkeleton",
          "when": "view == trishAICoverageView && viewItem == codeFile",
          "group": "inline"
        },
        {
          "command": "trishAI.updateSkeleton",
          "when": "view == trishAICoverageView && viewItem == codeFileIndexed",
          "group": "inline"
        },
        {
          "command": "trishAI.generateSkeleton",
          "when": "view == trishAICoverageView && viewItem == codeFolder",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "trishAICoverageView.refresh",
          "when": "view == trishAICoverageView",
          "group": "navigation"
        },
        {
          "command": "trishAI.askLibrarian",
          "when": "view == trishAICoverageView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}